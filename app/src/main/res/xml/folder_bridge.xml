<?xml version="1.0" encoding="utf-8"?>

<!--
  ~ Folder bridge preferences.
  -->

<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="recordings_browse"
        android:title="@string/fw_recordings_browse" />
    <Preference
        android:key="recordings_transcripts"
        android:title="@string/fw_transcripts"
        android:summary="@string/fw_transcripts_empty" />

    <me.zhanghai.android.files.folderbridge.FolderBridgeStatePreference
        android:key="folder_bridge_state"
        android:disableDependentsState="true"
        android:title="@string/fw_folder_bridge_state_title" />

    <me.zhanghai.android.files.folderbridge.FolderBridgeStatusPreference
        android:title="@string/fw_folder_bridge_status_title" />

    <PreferenceCategory android:title="@string/fw_folder_bridge_configuration_title">

        <me.zhanghai.android.files.folderbridge.FolderBridgeDirectoryPreference
            android:key="folder_bridge_directory"
            android:title="@string/fw_folder_bridge_directory_title" />
    </PreferenceCategory>
</PreferenceScreen>
